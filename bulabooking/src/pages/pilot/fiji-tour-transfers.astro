---
import {pilotTours,pilotProvider,transferPartner,pilotFx,pilotTransferReferralUrl,tourTransferReferralUrl} from '../../data/pilot-tours.mjs';
---
<!doctype html>
<html lang="en" data-pilot-fx-rate={pilotFx.rate} data-pilot-fx-as-of={pilotFx.asOf}>
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<meta name="robots" content="noindex,nofollow"/>
<meta name="description" content="Development-only Fiji Tour Transfers and Nadi Airport Transfers referral pilot."/>
<title>Fiji Tour Transfers | BulaBooking pilot</title>
<style>
:root{font-family:system-ui,sans-serif;color:#143238;background:#f6fbfa}
*{box-sizing:border-box}body{margin:0}main{max-width:1080px;margin:auto;padding:24px 18px}
a{color:#087b73}h1{font-size:clamp(2rem,5vw,3.5rem)}p{line-height:1.55;color:#50666b}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px}
.card{background:white;border:1px solid #d4e7e3;border-radius:16px;padding:22px}
.button{display:inline-block;padding:12px 16px;border-radius:10px;background:#087b73;color:white;text-decoration:none;font-weight:700}
.notice{background:#fff3d7;border-radius:12px;padding:16px}.small{font-size:.88rem;color:#60757b}section{margin:32px 0}
</style>
</head>
<body><main>
<a href="/">← BulaBooking</a>
<p>Powered by <a href="https://vakaviti.ai/" rel="noopener noreferrer">Vakaviti AI</a></p>
<h1>Fiji Tour Transfers — pilot experiences</h1>
<p>Development-only pilot for provider attribution, tour discovery and external transfer referrals.</p>
<p class="notice"><strong>Not live:</strong> Provider participation, prices, inclusions and booking availability require confirmation. FJD prices are indicative conversions of AUD source prices, not provider-approved FJD selling prices. No bookings are taken here.</p>
<p class="small">Historical exchange-rate snapshot (not live): 1 AUD = {pilotFx.rate} FJD, recorded {pilotFx.asOf}. <a href={pilotFx.source} target="_blank" rel="noopener noreferrer">Rate source</a>. Not a live rate or guaranteed price.</p>
<section><h2>Explore selected tours</h2><div class="grid">
{pilotTours.map(t => <article class="card">
<p class="small">{t.area} · {t.duration}</p>
<h3>{t.title}</h3><p>{t.summary}</p>
<p class="small" data-pilot-price data-aud={t.sourcePrice}>FJD estimate unavailable until current rate is checked · Original source AU${t.sourcePrice} · Verify final price on provider website</p>
{t.linkStatus === 'verified_destination' ? <a class="button" href={t.sourceUrl} rel="noopener noreferrer sponsored" target="_blank">View tour and check availability</a> : <p class="notice">Direct tour link is under review. <a href={pilotProvider.website} rel="noopener noreferrer" target="_blank">Check the provider's website</a> for current listings and availability.</p>}
<p class="small">External website: {pilotProvider.name}</p>
<p><a href={tourTransferReferralUrl(t.slug)} rel="noopener noreferrer sponsored" target="_blank">Need transport? Check private transfers</a></p>
<p class="small">Affiliated transfer service · Not included unless confirmed by tour provider</p>
</article>)}
</div></section>
<section class="card"><h2>Need a private transfer?</h2>
<p>{transferPartner.name} is an affiliated transfer service. Transfers are booked separately on its own website; transport may already be included with some tours.</p>
<a class="button" href={pilotTransferReferralUrl()} rel="noopener noreferrer sponsored" target="_blank">Check Fiji transfer prices</a>
<p class="small">Affiliated service · Opens NadiAirportTransfers.com</p>
</section>
<section><h2>About the pilot provider</h2><p>{pilotProvider.name} publishes tour information on its own website. This pilot does not imply completed operator verification or endorsement.</p>
<a href={pilotProvider.website} rel="noopener noreferrer" target="_blank">Visit Fiji Tour Transfers</a></section>
</main>
<script is:inline>
(function(){
 const rate=Number(document.documentElement.dataset.pilotFxRate);
 const observed=Date.parse(document.documentElement.dataset.pilotFxAsOf||'');
 const age=Date.now()-observed;
 const valid=Number.isFinite(rate)&&rate>0&&Number.isFinite(age)&&age>=0&&age<=259200000;
 document.querySelectorAll('[data-pilot-price]').forEach(el=>{
  const aud=Number(el.dataset.aud);
  if(!valid||!Number.isFinite(aud)||aud<=0){
   el.textContent='FJD estimate unavailable. Original AUD price: '+(Number.isFinite(aud)&&aud>0?aud:'not available')+'. Verify current provider price.';
   return;
  }
  el.textContent='Approximate FJD '+(Math.round(aud*rate*100)/100).toFixed(2)+' converted from AUD '+aud+'. Verify final provider price.';
 });
})();
</script>
</body></html>