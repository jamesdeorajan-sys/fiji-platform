---
import {pilotTours,pilotProvider,transferPartner} from '../../data/pilot-tours.mjs';
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><meta name="description" content="Development-only pilot of Fiji Tour Transfers tours and Nadi Airport Transfers partner links, powered by Vakaviti AI."/><title>Fiji Tour Transfers | BulaBooking pilot</title><style>:root{font-family:system-ui,sans-serif;color:#143238;background:#f6fbfa}*{box-sizing:border-box}body{margin:0}main{max-width:1080px;margin:auto;padding:24px 18px}a{color:#087b73}h1{font-size:clamp(2rem,5vw,3.5rem)}p{line-height:1.55;color:#50666b}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px}.card{background:white;border:1px solid #d4e7e3;border-radius:16px;padding:22px}.button{display:inline-block;padding:12px 16px;border-radius:10px;background:#087b73;color:white;text-decoration:none;font-weight:700}.notice{background:#fff3d7;border-radius:12px;padding:16px}.small{font-size:.88rem;color:#60757b}section{margin:32px 0}</style></head><body><main><a href="/">← BulaBooking</a><p>Powered by <a href="https://vakaviti.ai/" rel="noopener noreferrer">Vakaviti AI</a></p><h1>Fiji Tour Transfers — pilot experiences</h1><p>Explore a selection of publicly listed Fiji tours. This is a development-only pilot to validate the guest journey, provider attribution and links to existing booking websites.</p><p class="notice"><strong>Not live:</strong> Provider participation, prices, inclusions and booking availability require confirmation. Source prices are advertised in AUD; BulaBooking's FJD pricing requirement is not yet satisfied. No bookings are taken here.</p><section><h2>Explore selected tours</h2><div class="grid">{pilotTours.map(t=><article class="card"><p class="small">{t.area} · {t.duration}</p><h3>{t.title}</h3><p>{t.summary}</p><p class="small">Source-listed from AU$ {t.sourcePrice} · Not an FJD quote · Verify on provider website</p><a class="button" href={t.sourceUrl} rel="noopener noreferrer sponsored" target="_blank">View tour and check availability</a><p class="small">External website: {pilotProvider.name}</p></article>)}</div></section><section class="card"><h2>Need a private transfer?</h2><p>{transferPartner.name} is an affiliated transfer service for airport arrivals and Fiji destinations. Transfer pricing and booking requests are handled on its own website; transport may already be included with some tours.</p><a class="button" href={transferPartner.website} rel="noopener noreferrer sponsored" target="_blank">Check Fiji transfer prices</a><p class="small">Affiliated service · Opens NadiAirportTransfers.com</p></section><section><h2>About the pilot provider</h2><p>{pilotProvider.name} publishes Fiji tour information on its own website. Pilot listing does not imply completed operator verification or endorsement.</p><a href={pilotProvider.website} rel="noopener noreferrer" target="_blank">Visit Fiji Tour Transfers</a></section></main></body></html>
