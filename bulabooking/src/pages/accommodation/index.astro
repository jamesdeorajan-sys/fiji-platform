---
import {accommodationSpecials} from '../../data/accommodation-specials.mjs';
import {publicSpecial} from '../../lib/monthly-specials.mjs';
import {buildPartnerBookingLink,accommodationReferralState} from '../../lib/accommodation-referrals.mjs';
const now=new Date().toISOString();
const approved=accommodationSpecials.filter(o=>o.publicationStatus==='approved');
const visible=approved.map(o=>({offer:publicSpecial(o,now),state:accommodationReferralState(o,now),raw:o})).filter(o=>['active','expired'].includes(o.state.state));
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>Fiji accommodation specials | BulaBooking preview</title><meta name="description" content="Discover limited-time Fiji accommodation promotions and reserve directly with participating properties. Powered by Vakaviti AI."/>
<style>:root{font-family:system-ui,sans-serif;color:#143238;background:#f6fbfa}*{box-sizing:border-box}body{margin:0}main{max-width:1050px;margin:auto;padding:28px 20px}a{color:#087b73}h1{font-size:clamp(2rem,5vw,3.5rem)}p{line-height:1.6;color:#52676a}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(270px,1fr));gap:18px}.card{background:white;border:1px solid #d3e5e1;border-radius:16px;padding:22px}.notice{background:#fff4df;padding:18px;border-radius:12px}.cta{display:inline-block;background:#087b73;color:white;padding:12px 18px;border-radius:9px;text-decoration:none;font-weight:700}.muted{color:#61777b}footer{margin-top:55px;padding-top:20px;border-top:1px solid #d3e5e1}@media(max-width:450px){main{padding:20px 16px}}</style></head>
<body><main><a href="/">← BulaBooking</a><p>Powered by <a href="https://vakaviti.ai/" rel="noopener noreferrer">Vakaviti AI</a></p><h1>Fiji accommodation specials</h1><p>Explore limited-time promotions from participating Fiji accommodation providers. Check real-time availability and complete your reservation on each provider's official website.</p><p class="notice"><strong>Development preview:</strong> No accommodation offers are live or accepting referrals through this page. BulaBooking does not handle hotel reservations, payments or room inventory.</p>
{visible.length===0?<section class="card"><h2>Partner offers coming soon</h2><p>Only operator-approved, genuine FJD offers will appear here. No invented prices, discounts, hotel reviews or availability.</p><a href="/accommodation/partners/">How accommodation partners can participate</a></section>:<div class="grid">{visible.map(({offer,state,raw})=><article class="card"><h2>{offer.title}</h2><p><strong>FJ${(offer.priceFjdCents/100).toFixed(2)}</strong> per {offer.priceBasis}</p><p>Eligible stays: {offer.stayFrom} to {offer.stayUntil}</p><p>Promotion expires: {offer.expiresAt}</p><p>{offer.terms}</p>{state.promotable?<a class="cta" href={buildPartnerBookingLink(raw,now).href} rel="noopener noreferrer sponsored" target="_blank">Book direct with accommodation</a>:<p class="muted"><strong>Offer expired.</strong> The promotional link is no longer available.</p>}<p class="muted">Availability, final pricing and reservations are managed by the accommodation provider.</p></article>)}</div>}
<footer>BulaBooking · Powered by Vakaviti AI · Development preview</footer></main></body></html>
