---
import {operators,evidenceById,verifiedReviews} from '../../data/operators.mjs';
import {listPublicOperators} from '../../lib/operator-directory.mjs';
const profiles=listPublicOperators(operators,evidenceById,verifiedReviews);
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>Fiji operators | BulaBooking preview</title><meta name="description" content="Discover Fiji experience operators with transparent verification status, FJD prices and verified guest reviews."/><style>:root{font-family:system-ui,sans-serif;color:#143238;background:#f6fbfa}body{margin:0}main{max-width:1050px;margin:auto;padding:32px 20px}a{color:#087b73}h1{font-size:clamp(2rem,5vw,3.6rem)}p{line-height:1.6;color:#52676a}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:16px}.card{background:white;border:1px solid #d3e5e1;border-radius:16px;padding:20px}.tag{display:inline-block;background:#e8f3f1;padding:7px 11px;border-radius:30px;font-size:.85rem}.notice{background:#fff5df;border-radius:12px;padding:18px}</style></head><body><main><a href="/">← BulaBooking</a><h1>Explore Fiji operators</h1><p>Find local experience providers, see their verification status and compare real FJD prices and completed-booking reviews.</p><p class="notice"><strong>Development preview:</strong> No operators are published or accepting bookings through this directory yet. Social accounts and ratings will appear only after their source is approved.</p>{profiles.length===0?<section class="card"><h2>Operator directory is being prepared</h2><p>We are not showing fabricated providers, ratings or booking availability.</p><a href="/operators/start/">Preview an operator listing</a></section>:<div class="grid">{profiles.map(p=><article class="card"><h2><a href={`/operators/${p.slug}/`}>{p.name}</a></h2><p>{p.area}</p><span class="tag">{p.trust.verificationLabel}</span><p>{p.reviewCount?p.averageRating+' / 5 · '+p.reviewCount+' verified reviews':'No verified reviews yet'}</p><p>{p.listings.length} published experiences</p></article>)}</div>}</main></body></html>
