---
import {operators,evidenceById,verifiedReviews} from '../../data/operators.mjs';
import {listPublicOperators} from '../../lib/operator-directory.mjs';
export function getStaticPaths(){
 return listPublicOperators(operators,evidenceById,verifiedReviews).map(profile=>({params:{slug:profile.slug},props:{profile}}));
}
const {profile}=Astro.props;
const money=cents=>'FJ$'+(cents/100).toFixed(2);
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>{profile.name} | BulaBooking preview</title><style>:root{font-family:system-ui,sans-serif;color:#143238;background:#f6fbfa}body{margin:0}main{max-width:900px;margin:auto;padding:28px 20px}a{color:#087b73}h1{font-size:clamp(2rem,5vw,3.4rem)}p{line-height:1.6;color:#52676a}.card{background:#fff;border:1px solid #d3e5e1;border-radius:15px;padding:22px;margin:18px 0}.tag{display:inline-block;background:#e7f3f0;border-radius:24px;padding:7px 12px}.price{font-size:1.25rem;color:#087b73;font-weight:750}.notice{background:#fff5df;border-radius:12px;padding:16px}li{margin:10px 0}</style></head><body><main><a href="/operators/">← All operators</a><h1>{profile.name}</h1><p>{profile.area}</p><span class="tag">{profile.trust.verificationLabel}</span><p>{profile.trust.disclosures}</p><p>{profile.description}</p><section class="card"><h2>Guest reviews</h2><p>{profile.reviewCount?`${profile.averageRating} / 5 from ${profile.reviewCount} verified reviews`:profile.reviewNotice}</p></section><section class="card"><h2>Fiji experiences</h2>{profile.listings.length===0?<p>No bookable experiences published yet.</p>:<ul>{profile.listings.map(l=><li><strong>{l.title}</strong> · <span class="price">{money(l.priceFjdCents)} per {l.priceBasis}</span> · {l.bookingEnabled?'Request booking through approved checkout when enabled':'Booking requests not enabled'}</li>)}</ul>}</section><section class="card"><h2>Operator social links</h2>{profile.links.length===0?<p>No public social links supplied.</p>:<ul>{profile.links.map(l=><li><a href={l.url} target="_blank" rel="noopener noreferrer nofollow ugc">{l.platform}</a> <small>· Operator-supplied, not independently verified</small></li>)}</ul>}</section><p class="notice">Preview only. Booking checkout, social ownership verification and 24/7 support are not connected on this page.</p></main></body></html>
