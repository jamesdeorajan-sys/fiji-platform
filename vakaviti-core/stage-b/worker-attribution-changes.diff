+// Milestone 35 (Issue #38 Step 3, CEO correction 2026-09-02) - source
+// attribution for the shared bookings table. Host header CANNOT be used
+// for this: both public storefronts call the exact same hardcoded
+// NADI_API_BASE ('https://api.nadiairporttransfers.com'), so a booking
+// placed via book.fijidash.com still arrives with
+// Host: api.nadiairporttransfers.com. The browser's Origin header is the
+// only reliable server-side signal - it reflects the page the guest is
+// actually on, is set by the browser itself (not app.js), and cannot be
+// forged from a normal page context the way a body field could be.
+// Closed allowlist, not a pattern match - an unrecognised or missing
+// Origin resolves to null/'unknown' rather than being guessed at.
+const STOREFRONT_ORIGIN_ALLOWLIST = {
+  'https://book.fijidash.com': { storefrontId: 'fijidash', canonicalSource: 'fijidash' },
+  'https://nadiairporttransfers.com': { storefrontId: 'nadiairporttransfers', canonicalSource: 'nadi_airport_transfers' },
+  'https://www.nadiairporttransfers.com': { storefrontId: 'nadiairporttransfers', canonicalSource: 'nadi_airport_transfers' },
+};
+
+// Resolves storefront/source attribution for a browser-originated request.
+// Deliberately takes the raw Request, not the parsed body - client-supplied
+// canonical_source/storefront_id are never read anywhere in this function
+// or its caller, so there is nothing for a guest's browser to override even
+// in principle. Non-browser/API traffic (partner, agent, direct_api) is
+// intentionally NOT handled here - Step 3 correction: that needs its own
+// authenticated/signed mechanism, out of scope for this release, and such
+// traffic falls through to 'unknown' exactly like any other unrecognised
+// Origin until that mechanism exists.
+function resolveStorefrontAttribution(request) {
+  const origin = request.headers.get('Origin');
+  if (origin && STOREFRONT_ORIGIN_ALLOWLIST[origin]) {
+    return { ...STOREFRONT_ORIGIN_ALLOWLIST[origin], originSeen: origin };
+  }
+  return { storefrontId: null, canonicalSource: 'unknown', originSeen: origin || null };
+}
