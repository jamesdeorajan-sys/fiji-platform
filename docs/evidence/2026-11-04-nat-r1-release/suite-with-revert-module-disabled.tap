      </div>
    </section>
    
    <!-- BOOKING ENGINE -->
    <section class="booking-section" id="booking">
      <div class="container">
        <!-- A5: trust bar above the booking widget. Reinforces the four hardest-
             working trust signals at the moment of intent. -->
        <div class="booking-trust-bar" aria-label="How your request works">
          <span class="btb-item"><span class="btb-tick">✓</span> Review the total before requesting</span>
          <span class="btb-item"><span class="btb-tick">✓</span> Human confirmation on WhatsApp</span>
          <span class="btb-item"><span class="btb-tick">✓</span> Local Fijian drivers</span>
          <span class="btb-item" style="white-space:normal"><span class="btb-tick">✓</span> 24/7 human reservations and guest support on WhatsApp</span>
        </div>
        <div id="bookingWidget">
        <div class="booking-card">
          <div class="booking-header">
            <h2>Book your transfer</h2>
            <p>Choose your journey and vehicle, then review the total before sending your request.</p>
          </div>
    
          <!-- STEP INDICATOR -->
          <div class="steps">
            <div class="step active" id="step-ind-1">
              <div class="step-num">1</div>
              <div class="step-label">Journey</div>
            </div>
            <div class="step-line"></div>
            <div class="step" id="step-ind-2">
              <div class="step-num">2</div>
              <div class="step-label">Vehicle</div>
            </div>
            <div class="step-line"></div>
            <div class="step" id="step-ind-3">
              <div class="step-num">3</div>
              <div class="step-label">Details</div>
            </div>
            <div class="step-line"></div>
            <div class="step" id="step-ind-4">
              <div class="step-num">4</div>
              <div class="step-label">Confirm</div>
            </div>
          </div>
    
          <!-- STEP 1: JOURNEY -->
          <div class="booking-step" id="step1">
            <div class="field-row">
              <div class="field-group">
                <label class="field-label" id="pickupLabel">
