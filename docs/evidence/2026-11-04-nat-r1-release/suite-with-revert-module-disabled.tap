            <!-- CUSTOM PICKUP PANEL -->
            <div class="custom-loc-panel" id="customPickupPanel" style="display:none">
              <div class="custom-loc-head">
                <strong>📍 Custom pickup address</strong>
                <span>Tell us where to find you — we'll match it to the nearest area for pricing.</span>
              </div>
              <div class="field-row">
                <div class="field-group" style="flex:1;min-width:0">
                  <label class="field-label" for="customPickupAddress">Your address / hotel / villa name</label>
                  <input type="text" id="customPickupAddress" class="field-input" placeholder="e.g. Wakaya Villa, 27 Beach Rd, Pacific Harbour" oninput="updatePricing()">
                </div>
                <div class="field-group" style="flex:0 0 240px">
                  <label class="field-label" for="customPickupZone">Pickup area</label>
                  <select id="customPickupZone" class="field-input" onchange="updatePricing()">
                    <option value="">Select zone...</option>
                    <option value="NADI_TOWN"        data-lat="-17.7996" data-lng="177.4096">Nadi / Wailoaloa</option>
                    <option value="DENARAU"          data-lat="-17.7726" data-lng="177.3879">Denarau Island</option>
                    <option value="VUDA_POINT"       data-lat="-17.6900" data-lng="177.3790">Vuda Point</option>
                    <option value="LAUTOKA"          data-lat="-17.6140" data-lng="177.4498">Lautoka</option>
                    <option value="MOMI_BAY"         data-lat="-17.8920" data-lng="177.2850">Momi Bay</option>
                    <option value="NATADOLA"         data-lat="-18.0810" data-lng="177.3770">Natadola</option>
                    <option value="SIGATOKA"         data-lat="-18.1434" data-lng="177.5075">Sigatoka / Coral Coast (West)</option>
                    <option value="CORAL_COAST_MID"  data-lat="-18.1700" data-lng="177.5900">Coral Coast (mid — Hideaway/Tambua)</option>
                    <option value="CORAL_COAST_EAST" data-lat="-18.1980" data-lng="177.6790">Coral Coast (east — Outrigger/Warwick/Naviti)</option>
                    <option value="PACIFIC_HARBOUR"  data-lat="-18.2750" data-lng="177.9030">Pacific Harbour / Beqa</option>
                    <option value="SUVA"             data-lat="-18.1416" data-lng="178.4210">Suva</option>
                    <option value="BA"               data-lat="-17.5310" data-lng="177.6700">Ba</option>
                    <option value="RAKIRAKI"         data-lat="-17.4200" data-lng="178.0000">Rakiraki / Volivoli</option>
                  </select>
                </div>
              </div>
            </div>
    
            <!-- CUSTOM DESTINATION PANEL -->
            <div class="custom-loc-panel" id="customDestPanel" style="display:none">
              <div class="custom-loc-head">
                <strong>📍 Custom destination address</strong>
                <span>Tell us your hotel name or address — we'll match it to the nearest area for pricing.</span>
              </div>
              <div class="field-row">
                <div class="field-group" style="flex:1;min-width:0">
                  <label class="field-label" for="customDestAddress">Hotel / address / villa name</label>
                  <input type="text" id="customDestAddress" class="field-input" placeholder="e.g. Wakaya Villa, 27 Beach Rd, Pacific Harbour" oninput="updatePricing()">
                </div>
                <div class="field-group" style="flex:0 0 240px">
                  <label class="field-label" for="customDestZone">Destination area</label>
                  <select id="customDestZone" class="field-input" onchange="updatePricing()">
                    <option value="">Select zone...</option>
                    <option value="NADI_TOWN"        data-lat="-17.7996" data-lng="177.4096">Nadi / Wailoaloa</option>
                    <option value="DENARAU"          data-lat="-17.7726" data-lng="177.3879">Denarau Island</option>
                    <option value="VUDA_POINT"       data-lat="-17.6900" data-lng="177.3790">Vuda Point</option>
                    <option value="LAUTOKA"          data-lat="-17.6140" data-lng="177.4498">Lautoka</option>
                    <option value="MOMI_BAY"         data-lat="-17.8920" data-lng="177.2850">Momi Bay</option>
                    <option value="NATADOLA"         data-lat="-18.0810" data-lng="177.3770">Natadola</option>
                    <option value="SIGATOKA"         data-lat="-18.1434" data-lng="177.5075">Sigatoka / Coral Coast (West)</option>
                    <option value="CORAL_COAST_MID"  data-lat="-18.1700" data-lng="177.5900">Coral Coast (mid — Hideaway/Tambua)</option>
                    <option value="CORAL_COAST_EAST" data-lat="-18.1980" data-lng="177.6790">Coral Coast (east — Outrigger/Warwick/Naviti)</option>
                    <option value="PACIFIC_HARBOUR"  data-lat="-18.2750" data-lng="177.9030">Pacific Harbour / Beqa</option>
                    <option value="SUVA"             data-lat="-18.1416" data-lng="178.4210">Suva</option>
                    <option value="BA"               data-lat="-17.5310" data-lng="177.6700">Ba</option>
                    <option value="RAKIRAKI"         data-lat="-17.4200" data-lng="178.0000">Rakiraki / Volivoli</option>
                  </select>
                </div>
              </div>
            </div>
    
            <!-- TRIP TYPE -->
            <div class="trip-type-row">
              <label class="field-label">Transfer type</label>
              <div class="trip-toggle">
                <button class="trip-btn active" onclick="setTripType('one-way', this)">One-way</button>
                <button class="trip-btn" onclick="setTripType('return', this)">Return trip</button>
              </div>
            </div>
    
            <!-- DATE/TIME -->
            <div class="field-row">
              <div class="field-group">
                <label class="field-label" for="travelDate">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                  Date of travel
                </label>
                <input type="date" id="travelDate" class="field-input" onchange="updatePricing()">
              </div>
              <div class="field-group">
                <label class="field-label" for="travelTime">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                  Pickup time
                </label>
                <input type="time" id="travelTime" class="field-input" value="10:00" onchange="updatePricing()">
              </div>
              <div class="field-group">
                <label class="field-label" id="paxLabel">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
                  Passengers
                </label>
                <div class="pax-counter" role="group" aria-labelledby="paxLabel">
                  <button type="button" class="pax-btn" onclick="changePax(-1)" aria-label="Fewer passengers">−</button>
                  <span class="pax-num" id="paxNum" aria-live="polite">2</span>
                  <button type="button" class="pax-btn" onclick="changePax(1)" aria-label="More passengers">+</button>
                  <span class="pax-label">adults</span>
                </div>
              </div>
            </div>
    
            <!-- RETURN TRIP DETAILS — conditional, shown only when "Return trip" is
                 selected above. Mirrors book.fijidash.com/index.html's
                 #returnTripFields block verbatim (same field names, same CSS
                 classes, same defaulting behaviour) — CEO P0 Round 3 fix for the
                 same gap FijiDash already closed: a return booking previously had
                 no return date/time/pickup captured anywhere on this site.
                 CORRECTION (2026-09-13 P0 booking-recovery audit): this comment
                 previously said submitNadiBooking() was "not yet wired" to read
                 these fields — that was stale. It has read them (return_date/
                 return_time/return_pickup_location, sent whenever
                 state.tripType === 'return') since Round 3 shipped; see
                 submitNadiBooking()'s own header comment in app.js. -->
            <div class="field-row" id="returnTripFields" style="display:none">
              <div class="field-group">
                <label class="field-label" for="returnDate">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                  Return date
                </label>
                <input type="date" id="returnDate" class="field-input" onchange="updatePricing()">
              </div>
              <div class="field-group">
                <label class="field-label" for="returnTime">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                  Return pickup time
                </label>
                <input type="time" id="returnTime" class="field-input" value="10:00">
              </div>
              <div class="field-group">
                <label class="field-label" for="returnPickupLocation">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
                  Return pickup location
                </label>
                <input type="text" id="returnPickupLocation" class="field-input" placeholder="Defaults to your destination — edit if leaving from elsewhere" oninput="this.dataset.dirty='true'">
              </div>
            </div>
    
            <!-- FLIGHT -->
            <div class="field-row">
              <div class="field-group" style="flex:1">
                <label class="field-label" for="flightNum">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/></svg>
                  Flight number — optional
                </label>
                <input type="text" id="flightNum" class="field-input" aria-describedby="flightHelp" placeholder="e.g. FJ401, QF351, NZ56" oninput="onFlightInput(); validateArrivalFlight()">
                <p id="flightHelp" class="field-hint" style="margin-top:8px">You can send this later if you don't have it yet.</p>
                <label class="field-hint" style="display:none" hidden aria-hidden="true">
                  <input type="checkbox" id="flightUnknown" tabindex="-1" onchange="validateArrivalFlight()"> I don't know my flight number yet
                </label>
                <p id="flightError" role="alert" hidden>Flight number is optional.</p>
                <div id="flightHint" class="field-hint flight-hint" style="display:none">
                  ✈ We track your flight. If you're late, we wait — at no extra charge.
                </div>
              </div>
              <div class="field-group" style="flex:1">
                <label class="field-label" id="luggageLabel">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
                  Luggage pieces
                </label>
                <div class="pax-counter" role="group" aria-labelledby="luggageLabel">
                  <button type="button" class="pax-btn" onclick="changeLuggage(-1)" aria-label="Fewer bags">−</button>
                  <span class="pax-num" id="luggageNum" aria-live="polite">2</span>
                  <button type="button" class="pax-btn" onclick="changeLuggage(1)" aria-label="More bags">+</button>
                  <span class="pax-label">bags</span>
                </div>
              </div>
            </div>
    
            <!-- DISTANCE PRICING PANEL -->
            <div class="pricing-panel" id="pricingPanel" style="display:none">
              <div class="pricing-header">
                <div class="pricing-header-left">
                  <div class="pricing-route" id="pricingRoute">—</div>
                  <div class="pricing-meta" id="pricingMeta">—</div>
                </div>
                <!-- A4: currency display toggle. Charging is always in FJD;
                     this only changes the on-screen reference number. -->
                <div class="currency-toggle">
                  <label for="currencySelect" class="currency-label">Show in</label>
                  <select id="currencySelect" class="currency-select" onchange="onCurrencyChange()">
                    <option value="FJD">FJ$ (Fijian dollar)</option>
                    <option value="AUD">AU$ (Australian)</option>
                    <option value="USD">US$ (US dollar)</option>
                    <option value="NZD">NZ$ (New Zealand)</option>
                    <option value="GBP">£ (British pound)</option>
                    <option value="EUR">€ (Euro)</option>
                  </select>
                </div>
              </div>
              <div class="discount-banner" id="discountBanner">
                <span class="discount-banner-icon">★</span>
                <span class="discount-banner-text">10% off automatically applied to bookings over FJ$50</span>
              </div>
              <div class="vehicle-cards" id="vehicleCards" role="radiogroup" aria-label="Vehicle prices"></div>
              <!-- Tour-bundle price summary. Renders only when a tour is in the
                   booking AND a vehicle has been selected. Shows the combined
                   transfer + tour total so the customer sees the full price up
                   front, not just at confirmation step. -->
              <div class="tour-bundle-summary" id="tourBundleSummary" style="display:none"></div>
            </div>
    
            <div class="empty-state" id="emptyState">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
              <p>Select pickup &amp; destination to see live pricing</p>
            </div>
    
            <div class="step-actions">
              <div></div>
              <button class="btn-primary" id="nextBtn1" onclick="goToStep(2)" disabled>
                Continue to vehicle selection
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </button>
            </div>
          </div>
    
          <!-- STEP 2: VEHICLE -->
          <div class="booking-step" id="step2" style="display:none">
            <h3 class="step-title">Choose your vehicle</h3>
            <p class="vehicle-hint" id="vehicleHint" role="status" aria-live="polite">Tap a vehicle to choose it. ★ Recommended is only a suggestion — nothing is selected yet.</p>
            <div class="vehicle-detail-cards" id="vehicleDetailCards" role="radiogroup" aria-label="Choose your vehicle"></div>
            <div class="extras-section">
              <h4 class="extras-title">Add-ons</h4>
              <div class="extras-grid">
                <label class="extra-item">
                  <input type="checkbox" id="extra-lei" onchange="updateExtras()">
                  <div class="extra-content">
                    <div class="extra-name">🌺 Shell lei welcome</div>
                    <div class="extra-price">Complimentary</div>
                  </div>
                </label>
                <label class="extra-item">
                  <input type="checkbox" id="extra-seat" onchange="updateExtras()">
                  <div class="extra-content">
                    <div class="extra-name">👶 Child/baby seat</div>
                    <div class="extra-price">+ FJ$8</div>
                  </div>
                </label>
                <label class="extra-item">
                  <input type="checkbox" id="extra-stop" onchange="updateExtras()">
                  <div class="extra-content">
                    <div class="extra-name">🛒 Supermarket stop</div>
                    <div class="extra-price">Complimentary</div>
                  </div>
                </label>
                <label class="extra-item">
                  <input type="checkbox" id="extra-surf" onchange="updateExtras()">
                  <div class="extra-content">
                    <div class="extra-name">🏄 Surfboard / oversized</div>
                    <div class="extra-price">+ FJ$24</div>
                  </div>
                </label>
              </div>
            </div>
            <div class="step-actions">
              <button class="btn-secondary" onclick="goToStep(1)">← Back</button>
              <button class="btn-primary" id="nextBtn2" onclick="goToStep(3)" disabled>
                Continue to passenger details
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </button>
            </div>
          </div>
    
          <!-- STEP 3: PASSENGER DETAILS -->
          <div class="booking-step" id="step3" style="display:none">
            <h3 class="step-title">Your details</h3>
            <div class="form-grid">
              <div class="field-group">
                <label class="field-label" for="firstName">First name *</label>
                <input type="text" id="firstName" class="field-input" autocomplete="given-name" placeholder="John" required>
              </div>
              <div class="field-group">
                <label class="field-label" for="lastName">Last name *</label>
                <input type="text" id="lastName" class="field-input" autocomplete="family-name" placeholder="Smith" required>
              </div>
              <div class="field-group">
                <label class="field-label" for="email">Email address *</label>
                <input type="email" id="email" class="field-input" autocomplete="email" placeholder="john@example.com" required>
              </div>
              <div class="field-group">
                <label class="field-label" for="phone">WhatsApp / Phone *</label>
                <input type="tel" id="phone" class="field-input" autocomplete="tel" placeholder="+61 400 000 000" required>
              </div>
              <div class="field-group" style="grid-column:1/-1">
                <label class="field-label" for="notes">Special requests (optional)</label>
                <textarea id="notes" class="field-input" rows="3" placeholder="e.g. travelling with infant, need wheelchair access, late night pickup..."></textarea>
              </div>
            </div>
            <div class="step-actions">
              <button class="btn-secondary" onclick="goToStep(2)">← Back</button>
              <button class="btn-primary" onclick="goToStep(4)">
                Review booking
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </button>
            </div>
          </div>
    
          <!-- STEP 4: CONFIRMATION -->
          <div class="booking-step" id="step4" style="display:none">
            <h3 class="step-title">Review & confirm</h3>
            <div class="confirmation-card" id="confirmationCard"></div>
            <div class="payment-info">
              <div class="payment-icon">🔒</div>
              <div class="payment-text">
                <strong>No payment needed now.</strong> After you submit, open WhatsApp and press Send; our Fiji team will reply Bula, vinaka and confirm availability and payment options with you. We accept credit card, bank transfer, and cash on arrival.
              </div>
            </div>
            <div class="step-actions">
              <button class="btn-secondary" onclick="goToStep(3)">← Back</button>
              <button class="btn-primary btn-confirm" onclick="confirmBooking()">
                ✓ Confirm booking request
              </button>
            </div>
          </div>
    
          <!-- SUCCESS step kept hidden; new bulaSuccess card replaces the widget after submission -->
          <div class="booking-step" id="stepSuccess" style="display:none"></div>
    
        </div>
        </div><!-- /#bookingWidget -->
    
        <!-- BULA SUCCESS CARD — shown after submission, replaces the entire booking widget -->
        <div class="bula-success" id="bulaSuccess" style="display:none">
          <div class="bula-success-inner">
            <div class="bula-burst">
              <div class="bula-flower">🌺</div>
              <div class="bula-rays"></div>
            </div>
            <div class="bula-eyebrow">Bula Vinaka!</div>
            <!-- WhatsApp reservation handoff (2026-10-05). The guest finishes the reservation by pressing Send in WhatsApp; our Fiji team replies "Bula, vinaka",
                 checks the details and confirms. The heading, button and instruction are identical in every state; only the status line (bulaLeadText) changes
                 with what is actually known about the online save: saved / could-not-confirm / not saved online. Opening WhatsApp never marks anything sent or confirmed. -->
            <h2 class="bula-title" id="bulaTitle">Finish your reservation on WhatsApp</h2>
            <div class="bula-ref" id="bulaRef"></div>
    
            <p class="bula-lead" id="bulaLeadText">
              This request has not been saved online. Your reservation details are ready to send on WhatsApp.
            </p>
    
            <p class="bula-handoff" id="bulaHandoff">Tap the green button, then press Send in WhatsApp to send your reservation details. Our Fiji team will reply Bula, vinaka, check your details and confirm your transfer with you.</p>
    
            <!-- Open-and-Send steps (2026-10-11 candidate). Sits directly above the button so the instruction is read at the moment of the tap. Static text: it never changes with the save state and
                 never claims anything was sent or confirmed. The paragraph above and the note below are unchanged. -->
            <ol class="bula-steps" id="bulaSteps" aria-label="How to send your reservation">
              <li><strong>Tap</strong> the green button</li>
              <li><strong>Press Send</strong> in WhatsApp</li>
              <li><strong>We reply</strong> and confirm with you</li>
            </ol>
            <p class="bula-steps-note">Press Send in WhatsApp to start your conversation with our Fiji team.</p>
    
            <a id="bulaWaBtn" href="https://wa.me/61478886145" target="_blank" rel="noopener" class="btn-whatsapp btn-whatsapp-primary bula-wa-btn">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M11.999 2C6.477 2 2 6.477 2 12c0 1.99.574 3.844 1.558 5.414L2 22l4.735-1.535A9.967 9.967 0 0012 22c5.523 0 10-4.477 10-10S17.522 2 11.999 2zM12 20c-1.77 0-3.41-.483-4.82-1.317l-.344-.204-3.578 1.158 1.112-3.508-.227-.362A7.96 7.96 0 014 12c0-4.418 3.582-8 8-8s8 3.582 8 8-3.582 8-8 8z"/></svg>
              <span>Open WhatsApp — send reservation</span>
            </a>
    
            <p class="bula-handoff-note"><strong>Opening WhatsApp alone does not send your request.</strong> Your transfer is confirmed only after our Fiji team confirms it with you.</p>
            <button id="bulaRetry" type="button" class="btn-secondary" hidden onclick="retryBooking()">Review and retry — keep my details</button>
    
            <!-- Optional 10% price-beat request (2026-10-11 candidate). Collapsed by default, below the normal WhatsApp button, and independent of it: it only opens a WhatsApp message to the same team number.
                 No price is calculated or promised here; the Fiji team verifies the guest's quote and confirms any new fare. Terms wording is DRAFT pending James's final text. -->
            <details class="price-beat" id="priceBeat">
              <summary>Found a lower total price elsewhere? <strong>We'll go 10% below it.</strong></summary>
              <div class="price-beat-body">
                <p>If you find a lower total price for the same journey, we will price your transfer <strong>10% below that verified total</strong>. That is 10% below their price, not 10% off ours.</p>
                <p>The offer applies when their quote is for:</p>
                <ul class="price-beat-terms">
                  <li>the same route and trip type (one-way or return)</li>
                  <li>the same pickup date and time</li>
                  <li>the same vehicle or service, for the same number of passengers</li>
                  <li>the same luggage and requested extras</li>
                  <li>a total that includes all mandatory charges</li>
                  <li>a current quote that is available for your journey</li>
                </ul>
                <p>Send us the quote below. Our Fiji team verifies it, and a reduced fare is confirmed only when they confirm it with you on WhatsApp. Until then your reservation stays at the fare you were shown. This is optional and does not affect your reservation or the WhatsApp message above.</p>
                <label for="pbPrice">Their total price (include the currency)</label>
                <input type="text" id="pbPrice" class="field-input" maxlength="40" autocomplete="off" placeholder="e.g. FJ$ 40">
                <label for="pbWhere">Where you saw it (company or website)</label>
                <input type="text" id="pbWhere" class="field-input" maxlength="120" autocomplete="off" placeholder="e.g. company or website">
                <a id="pbSend" class="btn-secondary price-beat-send" href="https://wa.me/61478886145" target="_blank" rel="noopener">Send price-beat request on WhatsApp</a>
                <p class="price-beat-note">WhatsApp opens with your journey details already typed. Press Send, and attach a screenshot or link of their quote if you can.</p>
              </div>
            </details>
    
            <!-- A2: free booking modification reassurance with one-tap WhatsApp link -->
            <div class="bula-modify">
              <p>
                Need to change pickup time, add a stop, or update flight details?
                Free up to 2 hours before pickup —
                <a id="bulaModifyLink" href="https://wa.me/61478886145" target="_blank" rel="noopener">just message us</a>.
              </p>
            </div>
    
            <div class="bula-divider"><span>★ While you're in Fiji ★</span></div>
    
            <div class="bula-promise">
              <h3>We're online for you — your whole stay</h3>
              <p>
                We're not a one-trip company. Save our WhatsApp number now —
                we're online <strong>throughout your time in Fiji</strong>, ready to
                organise <strong>any transfer, any tour, any errand</strong>. Your
                personal on-island concierge.
              </p>
              <ul class="bula-services">
                <li><span>🚗</span> Last-minute private transfers, day or night</li>
                <li><span>🌴</span> Tours — Sigatoka Sand Dunes, kava ceremonies, waterfalls, shark dives, Cultural Night</li>
                <li><span>🛒</span> Supermarket, bottle shop &amp; produce-market runs</li>
                <li><span>💊</span> Pharmacy &amp; chemist pickups (yes, even prescriptions)</li>
                <li><span>🍽</span> Restaurant runs, takeaways &amp; dinner reservations</li>
                <li><span>🛬</span> Domestic flight transfers (Nausori, Savusavu, Taveuni connections)</li>
                <li><span>⛵</span> Port Denarau ferry / Yasawa Flyer / cruise connections</li>
                <li><span>🏥</span> Hospital, clinic, dentist or any urgent medical run</li>
              </ul>
              <p class="bula-cta-line">
                <strong>One message. We sort it.</strong> WhatsApp our team now —
                it's the same team that is arranging your transfer.
              </p>
            </div>
    
            <div class="bula-actions">
              <a href="https://wa.me/61478886145?text=Hi%20Fiji%20Tour%20Transfers%2C%20I%27m%20saving%20your%20number%20for%20my%20Fiji%20trip%20%F0%9F%8C%BA" target="_blank" rel="noopener" class="btn-whatsapp">
                💬 Save us on WhatsApp
              </a>
              <button class="btn-secondary" onclick="resetBooking()">Book another transfer</button>
            </div>
    
            <p class="bula-foot">
              Vinaka vakalevu — see you in paradise! 🌺<br>
              <em>The Fiji Tour Transfers team</em>
            </p>
          </div>
        </div>
    
      </div>
    </section>
    
    <!-- HOW IT WORKS -->
    <section class="how-section">
      <div class="container">
        <div class="section-header">
          <span class="section-eyebrow">Simple process</span>
          <h2>How it works</h2>
          <p>Book in under 60 seconds. No app download needed.</p>
        </div>
        <div class="how-grid">
          <div class="how-card">
            <div class="how-num">01</div>
            <div class="how-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <h3>Enter your route</h3>
            <p>Select pickup and destination. Distance is calculated instantly and your price appears in real time — no hidden fees.</p>
          </div>
          <div class="how-card">
            <div class="how-num">02</div>
            <div class="how-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            </div>
            <h3>Choose your vehicle</h3>
            <p>Sedan, minivan or minibus — pick what fits your group and budget. Add child seats, supermarket stops, and more.</p>
          </div>
          <div class="how-card">
            <div class="how-num">03</div>
            <div class="how-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 014.35 12a19.79 19.79 0 01-3.07-8.67A2 2 0 013.22 1.32h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L7.09 9.32a16 16 0 006.29 6.29l1.37-1.37a2 2 0 012.12-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
            </div>
            <h3>Confirm & relax</h3>
            <p>Send your reservation on WhatsApp and our Fiji team confirms your transfer with you. Your driver tracks your flight and meets you in arrivals with a name board and shell lei.</p>
          </div>
          <div class="how-card">
            <div class="how-num">04</div>
            <div class="how-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2z"/></svg>
            </div>
            <h3>Arrive in style</h3>
            <p>Door-to-door service, AC vehicles, local knowledge. Start your Fiji holiday the right way — with a genuine "Bula!"</p>
          </div>
        </div>
      </div>
    </section>
    
    <!-- ROUTES SECTION -->
    <section class="routes-section" id="routes">
      <div class="container">
        <div class="section-header">
          <span class="section-eyebrow">Transfer routes</span>
          <h2>All routes &amp; major Fiji hotels — fixed FJ$ pricing</h2>
          <p>Distance-based pricing in Fijian Dollars (FJD). The further you go, the lower your effective per-km rate. Don't see your hotel? Use the booking widget — pick "📍 Other / not listed" and type your address.</p>
          <p><strong>Private airport transfer prices are per vehicle, not per person.</strong> Each fare below covers the whole sedan, minivan or minibus, and optional extras are a child/baby seat option (currently FJ$8 in the booking form, subject to team confirmation) and a surfboard or oversized item (FJ$24). Pickups late at night or very early in the morning can carry a surcharge; our team confirms the applicable charge with you. Review your displayed quote before sending your request. Our Fiji team confirms availability, pickup arrangements and the total payable with you. Travelling with children? See <a href="/nadi-airport-transfers-with-child-seats/">Nadi Airport transfers with child seats</a>.</p>
        </div>
        <div class="promo-banner">
          <span class="promo-icon">★</span>
          <strong>10% OFF every booking over FJ$50</strong>
          <span class="promo-sub">Discount applies automatically at checkout — visible on every quote</span>
        </div>
        <nav aria-label="Popular airport transfer routes by area" style="margin:0 0 28px">
          <div style="display:flex;flex-wrap:wrap;justify-content:center;gap:18px 28px">
            <div style="min-width:200px">
              <div style="font-size:12px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:var(--mid);margin-bottom:8px;text-align:center">Denarau</div>
              <div style="display:flex;flex-wrap:wrap;justify-content:center;gap:8px">
                <a href="/transfer/port-denarau" class="route-pill">Port Denarau</a>
                <a href="/transfer/hilton-fiji-beach-resort" class="route-pill">Hilton Fiji Beach Resort</a>
                <a href="/transfer/port-denarau-marina" class="route-pill">Port Denarau Marina</a>
              </div>
            </div>
            <div style="min-width:260px">
              <div style="font-size:12px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:var(--mid);margin-bottom:8px;text-align:center">Coral Coast</div>
              <div style="display:flex;flex-wrap:wrap;justify-content:center;gap:8px">
                <a href="/transfer/natadola-intercontinental" class="route-pill">Natadola / InterContinental</a>
                <a href="/transfer/coral-coast-outrigger" class="route-pill">Coral Coast / Outrigger</a>
                <a href="/transfer/shangri-la-yanuca-island" class="route-pill">Shangri-La Yanuca Island</a>
                <a href="/transfer/naviti-resort" class="route-pill">The Naviti Resort</a>
              </div>
            </div>
            <div style="min-width:180px">
              <div style="font-size:12px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:var(--mid);margin-bottom:8px;text-align:center">Pacific Harbour</div>
              <div style="display:flex;flex-wrap:wrap;justify-content:center;gap:8px">
                <a href="/transfer/pacific-harbour" class="route-pill">Pacific Harbour</a>
                <a href="/transfer/pearl-south-pacific-resort" class="route-pill">Pearl South Pacific Resort</a>
              </div>
            </div>
            <div style="min-width:120px">
              <div style="font-size:12px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:var(--mid);margin-bottom:8px;text-align:center">Suva</div>
              <div style="display:flex;flex-wrap:wrap;justify-content:center;gap:8px">
                <a href="/transfer/suva" class="route-pill">Suva</a>
              </div>
            </div>
            <div style="min-width:160px">
              <div style="font-size:12px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:var(--mid);margin-bottom:8px;text-align:center">Families</div>
              <div style="display:flex;flex-wrap:wrap;justify-content:center;gap:8px">
                <a href="/nadi-airport-transfers-with-child-seats/" class="route-pill">Transfers with child seats</a>
              </div>
            </div>
            <div style="min-width:160px">
              <div style="font-size:12px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:var(--mid);margin-bottom:8px;text-align:center">Sonaisali</div>
              <div style="display:flex;flex-wrap:wrap;justify-content:center;gap:8px">
                <a href="/transfer/doubletree-sonaisali-island" class="route-pill">DoubleTree Sonaisali</a>
              </div>
            </div>
          </div>
        </nav>
        <style>.route-pill{background:var(--sand);border:1px solid var(--border-light);border-radius:20px;padding:8px 16px;font-size:13px;color:var(--ocean-dark);font-weight:500;white-space:nowrap}</style>
        <div class="routes-table-wrap">
          <table class="routes-table">
            <thead>
              <tr>
                <th>Destination / Area</th>
                <th>Distance</th>
                <th>Journey time</th>
                <th>Sedan (1–3 pax)</th>
                <th>Minivan (4–7 pax)</th>
                <th>Minibus (8–12 pax)</th>
                <th></th>
              </tr>
            </thead>
